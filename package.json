{
  "name": "markdown-x-publisher",
  "version": "0.1.11",
  "description": "Preview Markdown notes and save X Article drafts using your Chrome session.",
  "type": "module",
  "main": "main.js",
  "author": "Ancle",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests",
    "check": "npm run build && npm run lint && npm test",
    "package": "npm run check && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cropperjs": "1.6.2",
    "markdown-it": "15.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@playwright/mcp": "0.0.83",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.5",
    "eslint": "9.30.1",
    "globals": "16.2.0",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1"
  }
}
